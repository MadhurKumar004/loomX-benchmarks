# config.env -- default environment for the loomX benchmark harness.
#
# Override any of these by sourcing the file and exporting the variable, or by
# passing them on the command line, e.g.:
#   LOOMX=/opt/loomX/bin/loomX RUNS=5 ./run_all.sh

# Path to the loomX translator binary.
# Default assumes you built loomX in-tree and the binary is next to the
# original benchmark harness. Adjust this to your installation.
export LOOMX="${LOOMX:-/home/kamini/projects/hackathon-rose/rose-install/bin/loomX}"

# Compilers.
export COMPILER_CPU="${COMPILER_CPU:-gcc}"
export COMPILER_GPU="${COMPILER_GPU:-clang}"

# GPU compute capability. Leave empty to auto-detect from nvidia-smi.
export GPU_ARCH="${GPU_ARCH:-}"

# Number of timing runs per configuration.
export RUNS="${RUNS:-10}"

# Problem-size argument passed to binaries (suite-specific defaults exist in
# run_suite.sh if this is left empty).
export BENCH_ARGS="${BENCH_ARGS:-}"

# Set to "yes" to lock GPU clocks while benchmarking (requires root).
export LOCK_CLOCKS="${LOCK_CLOCKS:-no}"

# ROSE library path. The translator needs librose.so at runtime.
# Prepend so it takes precedence over any system-wide setting.
export LD_LIBRARY_PATH="/home/kamini/projects/hackathon-rose/rose-install/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Python scripts directory (derived automatically; do not edit unless you move
# the scripts).
export SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export LOOMX_SCRIPTS="$SCRIPT_DIR/scripts"
