# config.env -- default environment for the loomX benchmark harness.
#
# Override any of these by sourcing the file and exporting the variable, or by
# passing them on the command line, e.g.:
#   LOOMX=/opt/loomX/bin/loomX RUNS=5 ./run_all.sh

# Path to the loomX translator binary.
# Default assumes you built loomX in-tree and the binary is next to the
# original benchmark harness. Adjust this to your installation.
export LOOMX="${LOOMX:-/home/kamini/projects/hackathon-rose/loomX/loomX}"

# ROSE installation prefix. loomX's Clang frontend needs the built-in C
# headers that ship with ROSE (e.g., clang-builtin-c.h).
export ROSE_INSTALL_PREFIX="${ROSE_INSTALL_PREFIX:-/home/kamini/projects/hackathon-rose/rose-install}"

# Compilers.
export COMPILER_CPU="${COMPILER_CPU:-gcc}"
export COMPILER_GPU="${COMPILER_GPU:-/home/kamini/projects/llvm-build-offload/bin/clang}"

# GPU compute capability. Leave empty to auto-detect from nvidia-smi.
# The local GPU reports sm_120, but CUDA 12.4 does not support it; compile for
# sm_89 and let the driver JIT to the native architecture.
export GPU_ARCH="${GPU_ARCH:-sm_89}"

# Number of timing runs per configuration.
export RUNS="${RUNS:-10}"

# Problem-size argument passed to binaries (suite-specific defaults exist in
# run_suite.sh if this is left empty).
export BENCH_ARGS="${BENCH_ARGS:-}"

# Set to "yes" to lock GPU clocks while benchmarking (requires root).
export LOCK_CLOCKS="${LOCK_CLOCKS:-no}"

# Set to "yes" to capture Nsight Systems GPU breakdowns. The installed nsys
# exporter is broken in this environment, so leave it off.
export USE_NSYS="${USE_NSYS:-no}"

# ROSE library path. The translator needs librose.so at runtime.
# Prepend so it takes precedence over any system-wide setting.
export LD_LIBRARY_PATH="/home/kamini/projects/hackathon-rose/rose-install/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Offload-capable clang runtimes. libomp/libomptarget are not installed to a
# system path, so add the build output directories.
export LD_LIBRARY_PATH="/home/kamini/projects/llvm-build-offload/runtimes/runtimes-bins/openmp/runtime/src:/home/kamini/projects/llvm-build-offload/lib/x86_64-unknown-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Rebuilt ROSE 2.16 library. loomX was relinked against the build-tree copy
# after the Float128 patch; keep it on the load path until it is reinstalled.
export LD_LIBRARY_PATH="/home/kamini/projects/hackathon-rose/rose-build/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Library search path used by clang during linking. Include the NVPTX device
# bitcode directory so -fopenmp-targets=... can find libomptarget-nvptx.bc.
export LIBRARY_PATH="/home/kamini/projects/llvm-build-offload/lib/nvptx64-nvidia-cuda:/home/kamini/projects/llvm-build-offload/runtimes/runtimes-bins/openmp/runtime/src:/home/kamini/projects/llvm-build-offload/lib/x86_64-unknown-linux-gnu${LIBRARY_PATH:+:$LIBRARY_PATH}"

# Python scripts directory (derived automatically; do not edit unless you move
# the scripts).
export SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export LOOMX_SCRIPTS="$SCRIPT_DIR/scripts"
