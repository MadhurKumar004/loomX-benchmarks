# config.env -- default environment for the loomX benchmark harness.

export LOOMX="${LOOMX:-/home/superboy/Desktop/MadhurKumar004/loomX/tools/loomX/build/loomX}"
export ROSE_INSTALL_PREFIX="${ROSE_INSTALL_PREFIX:-/home/superboy/Desktop/MadhurKumar004/loomX/install}"

export COMPILER_CPU="${COMPILER_CPU:-gcc}"
export COMPILER_GPU="${COMPILER_GPU:-/usr/lib/llvm-15/bin/clang}"

# clang 15 ships without clang-offload-packager; we provide it from the
# clang-tools-15 package via ~/.local/bin so OpenMP offload compile works.
export PATH="${HOME}/.local/bin${PATH:+:$PATH}"

# CUDA toolkit used for the NVPTX device bitcode. The driver is newer than what
# clang 15 supports, but the 12.4 toolkit libdevice works.
export CUDA_PATH="${CUDA_PATH:-/usr/local/cuda-12.4}"

# RTX 4050 Laptop is compute capability 8.9, but clang 15 + CUDA 12.4's
# libdevice cannot target sm_89. sm_86 is the highest supported; the driver JITs
# the PTX to the native architecture.
export GPU_ARCH="${GPU_ARCH:-sm_86}"

# Extra flags forwarded to every loomX invocation (e.g. cost-model tuning):
#   LOOMX_ARGS="--pcie-factor 0.15 --gpu-compute-throughput 12000 ..."
export LOOMX_ARGS="${LOOMX_ARGS:-}"

export RUNS="${RUNS:-10}"
export BENCH_ARGS="${BENCH_ARGS:-}"

# Path to the LLVM Test Suite checkout. The harness uses single-source C
# benchmarks from SingleSource/Benchmarks.
export LLVM_TEST_SUITE_DIR="${LLVM_TEST_SUITE_DIR:-$SCRIPT_DIR/suites/llvm-test-suite}"

# Path to the NPB3.0-omp-C checkout. The harness uses single-source C benchmarks
# from BT, CG, EP, FT, MG, SP (LU and IS are excluded due to transformation
# issues).  Class S is the default for manageable runtimes; set NPB_CLASS=W or
# B for larger problem sizes.
export NPB_DIR="${NPB_DIR:-$SCRIPT_DIR/suites/NPB3.0-omp-C}"
export NPB_CLASS="${NPB_CLASS:-S}"

# Path to the Parboil checkout. The harness uses the sequential C base/CPU
# implementations and patches them for portability.
export PARBOIL_DIR="${PARBOIL_DIR:-$SCRIPT_DIR/suites/parboil}"

# Set to "yes" to lock GPU clocks while benchmarking (requires root).
export LOCK_CLOCKS="${LOCK_CLOCKS:-no}"
export USE_NSYS="${USE_NSYS:-no}"

# ROSE library search paths and system LLVM 15 lib directory
export LD_LIBRARY_PATH="/home/superboy/Desktop/MadhurKumar004/rose-build/lib:/home/superboy/Desktop/MadhurKumar004/loomX/install/lib:/usr/lib/llvm-15/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Library search path for linking NVPTX device bitcode
export LIBRARY_PATH="/usr/lib/llvm-15/lib${LIBRARY_PATH:+:$LIBRARY_PATH}"

# Python scripts directory.
export SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export LOOMX_SCRIPTS="$SCRIPT_DIR/scripts"
